---
interface Props {
  username: string;
  theme?: string;
  langsCount?: number;
}

const { username, theme = "tokyonight", langsCount = 8 } = Astro.props;
---

<div class="flex justify-center" data-github-toplangs>
  <img
    src={`https://github-readme-stats.vercel.app/api/top-langs/?username=${username}&layout=compact&theme=${theme}&hide_border=true&bg_color=00000000&langs_count=${langsCount}`}
    alt={`${username}'s Top Languages`}
    loading="lazy"
    class="max-w-full h-auto"
  />
  <div class="hidden p-4 text-center text-gray-500 text-sm" data-fallback>
    <a
      href={`https://github.com/${username}`}
      target="_blank"
      rel="noopener noreferrer"
      class="text-blue-400 hover:underline"
    >
      View Top Languages →
    </a>
  </div>
</div>

<script is:inline>
  document.querySelectorAll('[data-github-toplangs] img').forEach(img => {
    img.addEventListener('error', () => {
      img.style.display = 'none';
      img.parentElement.querySelector('[data-fallback]').classList.remove('hidden');
    });
  });
</script>
