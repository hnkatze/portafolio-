---
interface Props {
  speed: number;
  class?: string;
}

const { speed, class: className } = Astro.props;
---

<div class={className} data-parallax-layer data-speed={speed} aria-hidden="true">
  <slot />
</div>

<script>
  import { parallax } from '@/lib/anime';

  document.querySelectorAll<HTMLDivElement>('[data-parallax-layer]').forEach((layer) => {
    const speed = parseFloat(layer.dataset.speed || '0');
    const parent = layer.closest('section') || layer.parentElement;
    if (parent) {
      parallax(parent, layer, speed);
    }
  });
</script>
