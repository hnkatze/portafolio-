---
import type { Experience, Lang } from '@/lib/types';
import { t } from '@/lib/i18n';
import ParallaxLayer from './ParallaxLayer.astro';

interface Props {
  experience: Experience[];
  lang: Lang;
}

const { experience, lang } = Astro.props;
---

<section id="experience" class="relative min-h-screen flex items-center py-24 overflow-hidden">
  <ParallaxLayer speed={-0.15} class="absolute inset-0 pointer-events-none">
    <div class="absolute top-20 left-10 w-64 h-64 bg-blue-500/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-80 h-80 bg-purple-500/5 rounded-full blur-3xl"></div>
  </ParallaxLayer>

  <div class="relative z-10 max-w-5xl mx-auto px-6 w-full">
    <div class="text-center mb-16" data-exp-heading>
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-4" data-i18n-en="Experience" data-i18n-es="Experiencia">Experience</h2>
      <p class="text-gray-400 max-w-xl mx-auto" data-i18n-en="My professional journey building web applications" data-i18n-es="Mi trayectoria profesional construyendo aplicaciones web">My professional journey building web applications</p>
    </div>

    <div class="relative" data-exp-timeline>
      <!-- Vertical timeline line (drawn on scroll) -->
      <div
        data-exp-line
        class="hidden md:block absolute left-1/2 -translate-x-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-blue-400/30 via-purple-500/20 to-transparent"
        style="transform-origin: top; transform: scaleY(0);"
      ></div>

      <div class="space-y-12">
        {experience.map((entry, index) => {
          const isLeft = index % 2 === 0;
          return (
            <div class="relative flex flex-col md:flex-row items-center md:items-start gap-6 md:gap-0" data-exp-entry>
              <!-- Timeline dot -->
              <div class="absolute left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-blue-400 border-4 border-[#0a0a0a] z-10 hidden md:block"></div>

              <!-- Content card -->
              <div class={`w-full md:w-[calc(50%-2rem)] ${isLeft ? 'md:mr-auto md:pr-8 md:text-right' : 'md:ml-auto md:pl-8'}`}>
                <div class="p-6 rounded-2xl bg-white/[0.03] border border-white/[0.06] hover:border-blue-400/20 transition-all duration-300">
                  <div class={`flex flex-col ${isLeft ? 'md:items-end' : ''}`}>
                    <span class="text-xs text-blue-400 font-medium mb-1">
                      {entry.startDate} — {entry.endDate}
                    </span>
                    <h3 class="text-lg font-bold text-white mb-1" data-i18n-en={t(entry.role, 'en')} data-i18n-es={t(entry.role, 'es')}>{t(entry.role, lang)}</h3>
                    <span class="text-sm text-gray-400 mb-3">{entry.company}</span>
                  </div>
                  <p class={`text-sm text-gray-400 leading-relaxed mb-3 ${isLeft ? 'md:text-right' : ''}`} data-i18n-en={t(entry.description, 'en')} data-i18n-es={t(entry.description, 'es')}>
                    {t(entry.description, lang)}
                  </p>
                  <ul class={`space-y-1 ${isLeft ? 'md:text-right' : ''}`}>
                    {entry.highlights.map((h) => (
                      <li class="text-xs text-gray-500" data-i18n-en={`${isLeft ? '' : '- '}${t(h, 'en')}${isLeft ? ' -' : ''}`} data-i18n-es={`${isLeft ? '' : '- '}${t(h, 'es')}${isLeft ? ' -' : ''}`}>
                        {isLeft ? '' : '- '}
                        {t(h, lang)}
                        {isLeft ? ' -' : ''}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  import { scrollReveal, animate, prefersReducedMotion } from '@/lib/anime';
  import { onScroll, utils } from 'animejs';

  scrollReveal('[data-exp-heading]', { repeat: true });
  scrollReveal('[data-exp-entry]', { stagger: 0.15, repeat: true });

  // --- Timeline drawing on scroll (desktop only) ---
  const line = document.querySelector<HTMLElement>('[data-exp-line]');
  const timeline = document.querySelector<HTMLElement>('[data-exp-timeline]');

  if (line && timeline) {
    if (prefersReducedMotion || window.innerWidth < 768) {
      utils.set(line, { scaleY: 1 });
    } else {
      animate(line, {
        scaleY: [0, 1],
        ease: 'linear',
        autoplay: onScroll({
          target: timeline,
          enter: 'top bottom',
          leave: 'bottom top',
          sync: true,
        }),
      });
    }
  }
</script>
