---
const islands = [
  { id: 'hero',         label: 'Home',         labelEs: 'Inicio' },
  { id: 'skills',       label: 'Skills',        labelEs: 'Habilidades' },
  { id: 'experience',   label: 'Experience',    labelEs: 'Experiencia' },
  { id: 'projects',     label: 'Projects',      labelEs: 'Proyectos' },
  { id: 'testimonials', label: 'Testimonials',  labelEs: 'Testimonios' },
  { id: 'integrations', label: 'GitHub',         labelEs: 'GitHub' },
  { id: 'contact',      label: 'Contact',       labelEs: 'Contacto' },
];
---

<!-- Floating top bar -->
<header id="journey-header" class="fixed top-0 left-0 right-0 z-50 bg-transparent transition-all duration-300" style="transform: translateY(-100px);">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <button id="nav-logo" data-magnetic class="text-lg font-bold text-white hover:text-blue-400 transition-colors">
      CH<span class="text-blue-400">.</span>
    </button>
    <div class="flex items-center gap-3">
      <button id="lang-toggle" data-magnetic class="flex items-center gap-1 px-3 py-2 text-sm font-medium rounded-lg border border-white/10 hover:border-blue-400/50 transition-all duration-300">
        <span id="lang-label" class="text-blue-400">EN</span>
        <svg class="w-3 h-3 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l4-4 4 4m0 6l-4 4-4-4" />
        </svg>
      </button>
      <button id="nav-cv-btn" data-magnetic class="px-4 py-2 text-sm font-medium text-gray-300 rounded-lg border border-white/10 hover:border-blue-400/50 hover:text-blue-400 transition-all duration-300" data-i18n-en="View CV" data-i18n-es="Ver CV">
        View CV
      </button>
    </div>
  </div>
</header>

<!-- Side dot navigation -->
<nav class="hidden md:flex fixed right-6 top-1/2 -translate-y-1/2 z-50 flex-col gap-4">
  {islands.map(({ id, label, labelEs }) => (
    <div class="group relative flex items-center">
      <span
        class="absolute right-8 text-xs text-blue-400 font-medium whitespace-nowrap opacity-0"
        data-nav-label={id}
        data-i18n-en={label}
        data-i18n-es={labelEs}
      >
        {label}
      </span>
      <button
        data-nav-dot={id}
        data-magnetic
        aria-label={`Navigate to ${label}`}
        class="w-3 h-3 rounded-full border-2 border-white/30 hover:border-blue-400/80 hover:scale-110 transition-all duration-300"
      />
    </div>
  ))}
</nav>

<script>
  import { animate, magnetic, prefersReducedMotion } from '@/lib/anime';

  // Magnetic effect on header CTAs and side nav dots (desktop only)
  document.querySelectorAll<HTMLElement>('#journey-header [data-magnetic]').forEach((el) => {
    magnetic(el, { strength: 0.3, radius: 80 });
  });
  document.querySelectorAll<HTMLElement>('[data-nav-dot]').forEach((el) => {
    magnetic(el, { strength: 0.5, radius: 60 });
  });

  const header = document.getElementById('journey-header')!;
  const sections = ['hero', 'skills', 'experience', 'projects', 'testimonials', 'integrations', 'contact'];
  let currentActive = 'hero';

  // --- Header entrance animation ---
  animate(header, {
    translateY: [-100, 0],
    duration: prefersReducedMotion ? 0 : 500,
    ease: 'outQuad',
  });

  // --- Scroll state ---
  function updateScrollState() {
    // Header background
    if (window.scrollY > 50) {
      header.classList.add('bg-[#0a0a0a]/80', 'backdrop-blur-md', 'border-b', 'border-white/5');
      header.classList.remove('bg-transparent');
    } else {
      header.classList.remove('bg-[#0a0a0a]/80', 'backdrop-blur-md', 'border-b', 'border-white/5');
      header.classList.add('bg-transparent');
    }

    // Active section detection
    const viewportCenter = window.innerHeight / 2;
    for (const id of sections) {
      const el = document.getElementById(id);
      if (!el) continue;
      const rect = el.getBoundingClientRect();
      if (rect.top <= viewportCenter && rect.bottom >= viewportCenter) {
        if (currentActive !== id) {
          setActiveDot(currentActive, false);
          setActiveDot(id, true);
          currentActive = id;
        }
        break;
      }
    }
  }

  function setActiveDot(id: string, active: boolean) {
    const dot = document.querySelector(`[data-nav-dot="${id}"]`) as HTMLButtonElement;
    const label = document.querySelector(`[data-nav-label="${id}"]`) as HTMLSpanElement;
    if (!dot || !label) return;

    const dur = prefersReducedMotion ? 0 : 200;

    if (active) {
      dot.classList.add('bg-blue-400', 'border-blue-400', 'shadow-[0_0_12px_rgba(96,165,250,0.5)]', 'scale-125');
      dot.classList.remove('border-white/30');
      animate(label, { opacity: [0, 1], translateX: [10, 0], duration: dur, ease: 'outQuad' });
    } else {
      dot.classList.remove('bg-blue-400', 'border-blue-400', 'shadow-[0_0_12px_rgba(96,165,250,0.5)]', 'scale-125');
      dot.classList.add('border-white/30');
      animate(label, { opacity: 0, translateX: 10, duration: dur, ease: 'outQuad' });
    }
  }

  // Set initial active dot
  setActiveDot('hero', true);

  window.addEventListener('scroll', updateScrollState, { passive: true });
  updateScrollState();

  // --- Dot click navigation ---
  document.querySelectorAll<HTMLButtonElement>('[data-nav-dot]').forEach(dot => {
    dot.addEventListener('click', () => {
      const id = dot.dataset.navDot!;
      document.getElementById(id)?.scrollIntoView({ behavior: 'smooth' });
    });
  });

  // --- Logo click ---
  document.getElementById('nav-logo')?.addEventListener('click', () => {
    document.getElementById('hero')?.scrollIntoView({ behavior: 'smooth' });
  });

  // --- CV button ---
  document.getElementById('nav-cv-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-cv-modal'));
  });

  // --- Language toggle ---
  const langToggle = document.getElementById('lang-toggle')!;
  const langLabel = document.getElementById('lang-label')!;
  let currentLang: 'en' | 'es' = (localStorage.getItem('lang') as 'en' | 'es') || 'en';

  function applyLang(lang: 'en' | 'es') {
    currentLang = lang;
    langLabel.textContent = lang.toUpperCase();
    localStorage.setItem('lang', lang);

    const attr = lang === 'en' ? 'data-i18n-en' : 'data-i18n-es';
    document.querySelectorAll(`[${attr}]`).forEach(el => {
      const value = (el as HTMLElement).getAttribute(attr);
      if (value !== null) el.textContent = value;
    });

    // Also update placeholder attributes
    const placeholderAttr = lang === 'en' ? 'data-placeholder-en' : 'data-placeholder-es';
    document.querySelectorAll(`[${placeholderAttr}]`).forEach(el => {
      const value = (el as HTMLElement).getAttribute(placeholderAttr);
      if (value !== null) (el as HTMLInputElement).placeholder = value;
    });

    window.dispatchEvent(new CustomEvent('lang-change', { detail: lang }));
  }

  langToggle.addEventListener('click', () => {
    applyLang(currentLang === 'en' ? 'es' : 'en');
  });

  // Apply saved language on load
  if (currentLang === 'es') applyLang('es');

  // --- Cleanup ---
  const cleanup = () => window.removeEventListener('scroll', updateScrollState);
  document.addEventListener('astro:before-swap', cleanup);
</script>
