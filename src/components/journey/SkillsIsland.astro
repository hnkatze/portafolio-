---
import type { Skill, SkillCategory, SkillLevel } from '@/lib/types';
import ParallaxLayer from './ParallaxLayer.astro';

interface Props {
  skills: Skill[];
}

const { skills } = Astro.props;

const categories: { key: SkillCategory; label: string }[] = [
  { key: 'frontend', label: 'Frontend' },
  { key: 'backend', label: 'Backend' },
  { key: 'tools', label: 'Tools' },
];

const levelConfig = {
  expert:     { label: 'Expert',     dots: 3, color: 'text-emerald-400', dotColor: 'bg-emerald-400', bg: 'bg-emerald-400/10', border: 'border-emerald-400/20' },
  proficient: { label: 'Proficient', dots: 2, color: 'text-blue-400',    dotColor: 'bg-blue-400',    bg: 'bg-blue-400/10',    border: 'border-blue-400/20' },
  familiar:   { label: 'Familiar',   dots: 1, color: 'text-gray-400',    dotColor: 'bg-gray-400',    bg: 'bg-white/5',        border: 'border-white/10' },
} satisfies Record<SkillLevel, { label: string; dots: number; color: string; dotColor: string; bg: string; border: string }>;

const levels: SkillLevel[] = ['expert', 'proficient', 'familiar'];

// Pre-group skills by category + level in frontmatter (avoids template generics issues)
type GroupedSkills = Record<SkillCategory, Record<SkillLevel, Skill[]>>;
const grouped: GroupedSkills = { frontend: { expert: [], proficient: [], familiar: [] }, backend: { expert: [], proficient: [], familiar: [] }, tools: { expert: [], proficient: [], familiar: [] } };
skills.forEach(s => grouped[s.category][s.level].push(s));
---

<section id="skills" class="relative min-h-screen flex items-center py-24 overflow-hidden">
  <ParallaxLayer speed={-0.2} class="absolute inset-0 pointer-events-none">
    <div class="absolute top-10 right-20 w-80 h-80 bg-purple-500/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-10 left-20 w-60 h-60 bg-blue-500/5 rounded-full blur-3xl"></div>
  </ParallaxLayer>

  <div class="relative z-10 max-w-6xl mx-auto px-6 w-full">
    <div class="text-center mb-12" data-skills-heading>
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-4" data-i18n-en="Skills & Technologies" data-i18n-es="Habilidades y Tecnologías">Skills & Technologies</h2>
      <p class="text-gray-400 max-w-xl mx-auto" data-i18n-en="Technologies I work with daily to build modern web applications" data-i18n-es="Tecnologías con las que trabajo a diario para construir aplicaciones web modernas">Technologies I work with daily to build modern web applications</p>

      <!-- Level legend -->
      <div class="flex items-center justify-center gap-6 mt-6 text-xs">
        {levels.map(level => {
          const cfg = levelConfig[level];
          return (
            <div class="flex items-center gap-1.5">
              <div class="flex gap-0.5">
                {[0, 1, 2].map(i => (
                  <span class:list={['w-1.5 h-1.5 rounded-full', i < cfg.dots ? cfg.dotColor : 'bg-white/10']} />
                ))}
              </div>
              <span class={cfg.color}>{cfg.label}</span>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Category tabs -->
    <div class="flex justify-center gap-2 mb-12" data-skills-tabs>
      {categories.map(({ key, label }) => (
        <button
          data-tab={key}
          class:list={[
            'px-5 py-2.5 rounded-xl text-sm font-medium transition-all duration-300',
            key === 'frontend'
              ? 'bg-blue-500/20 text-blue-400 border border-blue-400/30'
              : 'bg-white/5 text-gray-400 border border-white/5 hover:text-white hover:border-white/10'
          ]}
        >
          {label}
        </button>
      ))}
    </div>

    <!-- Skill grids per category -->
    {categories.map(({ key }) => (
      <div
        data-category={key}
        class:list={['space-y-8', key !== 'frontend' && 'hidden']}
      >
        {levels.map(level => {
          const group = grouped[key][level];
          if (group.length === 0) return null;
          const cfg = levelConfig[level];

          return (
            <div data-skill-group>
              <div class="flex items-center gap-3 mb-4">
                <div class="flex gap-0.5">
                  {[0, 1, 2].map(i => (
                    <span class:list={['w-2 h-2 rounded-full', i < cfg.dots ? cfg.dotColor : 'bg-white/10']} />
                  ))}
                </div>
                <span class:list={['text-sm font-medium', cfg.color]}>{cfg.label}</span>
                <div class="flex-1 h-px bg-white/5"></div>
              </div>

              <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
                {group.map((skill, i) => (
                  <div class="group" data-skill-card data-index={i}>
                    <div
                      class:list={[
                        'relative flex items-center gap-3 p-4 rounded-2xl border transition-all duration-300 cursor-default',
                        cfg.bg, cfg.border,
                        'hover:border-blue-400/40 hover:bg-white/[0.06]'
                      ]}
                      data-tilt-card
                      style="transition: transform 0.15s ease-out, background-color 0.3s, border-color 0.3s;"
                    >
                      <img
                        src={skill.icon}
                        alt={skill.name}
                        class="w-8 h-8 object-contain shrink-0"
                        loading="lazy"
                      />
                      <span class="text-sm font-medium text-white truncate">{skill.name}</span>
                      {skill.favorite && (
                        <span class="ml-auto text-xs text-yellow-400 shrink-0" aria-label="Favorite skill">&#9733;</span>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    ))}
  </div>
</section>

<script>
  import { gsap, scrollReveal, prefersReducedMotion } from '@/lib/gsap';

  // --- Scroll reveal for heading and tabs ---
  scrollReveal('[data-skills-heading]');
  scrollReveal('[data-skills-tabs]', { delay: 0.1 });

  // --- Tab switching ---
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-tab]');
  const grids = document.querySelectorAll<HTMLDivElement>('[data-category]');
  const activeClasses = ['bg-blue-500/20', 'text-blue-400', 'border-blue-400/30'];
  const inactiveClasses = ['bg-white/5', 'text-gray-400', 'border-white/5'];

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const category = tab.dataset.tab!;

      tabs.forEach(t => {
        t.classList.remove(...activeClasses);
        t.classList.add(...inactiveClasses);
      });
      tab.classList.remove(...inactiveClasses);
      tab.classList.add(...activeClasses);

      grids.forEach(g => {
        if (g.dataset.category === category) {
          g.classList.remove('hidden');
          const cards = g.querySelectorAll('[data-skill-card]');
          gsap.from(cards, {
            opacity: 0, y: 20,
            duration: prefersReducedMotion ? 0 : 0.4,
            stagger: 0.03,
            ease: 'power2.out',
          });
        } else {
          g.classList.add('hidden');
        }
      });
    });
  });

  // --- 3D Tilt effect ---
  if (!prefersReducedMotion) {
    document.querySelectorAll<HTMLDivElement>('[data-tilt-card]').forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        card.style.transform = `perspective(1000px) rotateX(${y * -8}deg) rotateY(${x * 8}deg) scale(1.02)`;
      });
      card.addEventListener('mouseleave', () => {
        card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale(1)';
      });
    });
  }

  // --- Card entrance animation ---
  scrollReveal('[data-category="frontend"] [data-skill-card]', { stagger: 0.03, duration: 0.4 });
</script>
