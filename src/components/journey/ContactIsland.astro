---
import type { PersonalInfo, Lang } from '@/lib/types';
import ParallaxLayer from './ParallaxLayer.astro';

interface Props {
  data: PersonalInfo;
  lang: Lang;
}

const { data } = Astro.props;
---

<section id="contact" class="relative min-h-screen flex items-center py-24 overflow-hidden">
  <ParallaxLayer speed={-0.1} class="absolute inset-0 pointer-events-none">
    <div class="absolute top-20 left-20 w-72 h-72 bg-blue-500/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 right-20 w-80 h-80 bg-purple-500/5 rounded-full blur-3xl"></div>
  </ParallaxLayer>

  <div class="relative z-10 max-w-3xl mx-auto px-6 w-full">
    <div class="text-center mb-12" data-contact-heading>
      <h2
        class="text-3xl md:text-5xl font-bold text-white mb-4"
        data-i18n-en="Get in Touch"
        data-i18n-es="Contacto"
      >Get in Touch</h2>
      <p
        class="text-gray-400 max-w-xl mx-auto"
        data-i18n-en="Have a project in mind? Let's work together"
        data-i18n-es="¿Tenés un proyecto en mente? Trabajemos juntos"
      >Have a project in mind? Let's work together</p>
    </div>

    <div data-contact-form-wrapper>
      <form id="contact-form" class="space-y-5 p-8 rounded-2xl bg-white/[0.03] border border-white/[0.06]">
        <div>
          <label for="name" class="block text-sm text-gray-400 mb-1.5" data-i18n-en="Name" data-i18n-es="Nombre">Name</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-blue-400/50 transition-colors"
            placeholder="Your name"
            data-placeholder-en="Your name"
            data-placeholder-es="Tu nombre"
          />
        </div>
        <div>
          <label for="title" class="block text-sm text-gray-400 mb-1.5" data-i18n-en="Subject" data-i18n-es="Asunto">Subject</label>
          <input
            id="title"
            name="title"
            type="text"
            required
            class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-blue-400/50 transition-colors"
            placeholder="Project inquiry, collaboration, etc."
            data-placeholder-en="Project inquiry, collaboration, etc."
            data-placeholder-es="Consulta de proyecto, colaboración, etc."
          />
        </div>
        <div>
          <label for="email" class="block text-sm text-gray-400 mb-1.5" data-i18n-en="Email" data-i18n-es="Email">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-blue-400/50 transition-colors"
            placeholder="your@email.com"
            data-placeholder-en="your@email.com"
            data-placeholder-es="tu@email.com"
          />
        </div>
        <div>
          <label for="message" class="block text-sm text-gray-400 mb-1.5" data-i18n-en="Message" data-i18n-es="Mensaje">Message</label>
          <textarea
            id="message"
            name="message"
            required
            rows="5"
            class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-blue-400/50 transition-colors resize-none"
            placeholder="Tell me about your project..."
            data-placeholder-en="Tell me about your project..."
            data-placeholder-es="Contame sobre tu proyecto..."
          ></textarea>
        </div>
        <button
          type="submit"
          id="contact-submit"
          class="w-full py-3 rounded-xl bg-blue-500/20 text-blue-400 font-medium border border-blue-400/30 hover:bg-blue-500/30 hover:scale-[1.01] active:scale-[0.99] disabled:opacity-50 disabled:cursor-not-allowed transition-all duration-300"
          data-i18n-en="Send Message"
          data-i18n-es="Enviar Mensaje"
        >
          Send Message
        </button>
      </form>
    </div>

    <!-- Social links + CV link -->
    <div class="mt-10 text-center" data-contact-social>
      <div class="flex items-center justify-center gap-4 mb-4">
        <a
          href={`https://github.com/${data.socials.github}`}
          target="_blank"
          rel="noopener noreferrer"
          class="p-3 rounded-xl bg-white/5 border border-white/10 text-gray-400 hover:text-white hover:border-blue-400/50 transition-all duration-300"
          aria-label="GitHub"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
          </svg>
        </a>
        <a
          href={data.socials.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="p-3 rounded-xl bg-white/5 border border-white/10 text-gray-400 hover:text-white hover:border-blue-400/50 transition-all duration-300"
          aria-label="LinkedIn"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
          </svg>
        </a>
        <a
          href={`mailto:${data.email}`}
          class="p-3 rounded-xl bg-white/5 border border-white/10 text-gray-400 hover:text-white hover:border-blue-400/50 transition-all duration-300"
          aria-label="Email"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
          </svg>
        </a>
      </div>
      <button
        id="contact-cv-btn"
        class="inline-block text-sm text-gray-400 hover:text-blue-400 transition-colors"
        data-i18n-en="View my CV →"
        data-i18n-es="Ver mi CV →"
      >
        View my CV →
      </button>
    </div>
  </div>
</section>

<script>
  import { scrollReveal } from '@/lib/gsap';
  import { submitFormData } from '@/lib/config';

  scrollReveal('[data-contact-heading]');
  scrollReveal('[data-contact-form-wrapper]', { delay: 0.1 });
  scrollReveal('[data-contact-social]', { delay: 0.2 });

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const data = {
      name: formData.get('name') as string,
      email: formData.get('email') as string,
      title: formData.get('title') as string,
      message: formData.get('message') as string,
    };

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';

    const success = await submitFormData(data);

    if (success) {
      submitBtn.textContent = 'Sent! \u2713';
      form.reset();
      setTimeout(() => {
        submitBtn.textContent = 'Send Message';
        submitBtn.disabled = false;
      }, 4000);
    } else {
      submitBtn.textContent = 'Send Message';
      submitBtn.disabled = false;
    }
  });

  // CV modal trigger
  document.getElementById('contact-cv-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-cv-modal'));
  });
</script>
