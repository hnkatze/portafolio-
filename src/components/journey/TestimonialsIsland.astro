---
import type { Testimonial, Lang } from '@/lib/types';
import { t } from '@/lib/i18n';
import ParallaxLayer from './ParallaxLayer.astro';

interface Props {
  testimonials: Testimonial[];
  lang: Lang;
}

const { testimonials, lang } = Astro.props;
---

<section id="testimonials" class="relative py-24 overflow-hidden">
  <ParallaxLayer speed={-0.15} class="absolute inset-0 pointer-events-none">
    <div class="absolute top-20 left-10 w-72 h-72 bg-amber-500/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-10 right-20 w-60 h-60 bg-blue-500/5 rounded-full blur-3xl"></div>
  </ParallaxLayer>

  <div class="relative z-10 max-w-6xl mx-auto px-6">
    <div class="text-center mb-16" data-testimonials-heading>
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-4" data-i18n-en="What Clients Say" data-i18n-es="Lo que dicen mis clientes">What Clients Say</h2>
      <p class="text-gray-400 max-w-xl mx-auto" data-i18n-en="Real feedback from people I've worked with" data-i18n-es="Opiniones reales de personas con las que he trabajado">Real feedback from people I've worked with</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {testimonials.map((item, i) => (
        <div
          class="group relative"
          data-testimonial-card
          data-index={i}
        >
          <div class="relative flex flex-col h-full p-6 rounded-2xl bg-white/[0.03] border border-white/[0.06] hover:border-amber-400/30 transition-all duration-300">
            <!-- Quote icon -->
            <svg
              class="w-8 h-8 text-amber-400/40 mb-4 shrink-0"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zM0 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151C7.546 6.068 5.983 8.789 5.983 11H10v10H0z" />
            </svg>

            <!-- Quote text -->
            <blockquote class="text-gray-300 text-sm leading-relaxed mb-6 flex-1" data-i18n-en={`"${t(item.quote, 'en')}"`} data-i18n-es={`"${t(item.quote, 'es')}"`}>
              "{t(item.quote, lang)}"
            </blockquote>

            <!-- Client info -->
            <div class="flex items-center gap-3 pt-4 border-t border-white/5">
              <!-- Avatar placeholder with initials -->
              <div class="w-10 h-10 rounded-full bg-gradient-to-br from-amber-400/20 to-orange-500/20 border border-amber-400/20 flex items-center justify-center shrink-0">
                <span class="text-xs font-bold text-amber-400">
                  {item.name.split(' ').map(w => w[0]).join('').slice(0, 2)}
                </span>
              </div>
              <div class="min-w-0">
                <p class="text-sm font-medium text-white truncate">{item.name}</p>
                <p class="text-xs text-gray-500 truncate" data-i18n-en={t(item.role, 'en')} data-i18n-es={t(item.role, 'es')}>{t(item.role, lang)}</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { scrollReveal } from '@/lib/anime';

  scrollReveal('[data-testimonials-heading]', { repeat: true });
  scrollReveal('[data-testimonial-card]', { stagger: 0.1, duration: 0.5, repeat: true });
</script>
