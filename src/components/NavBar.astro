<style>
  .navbar {
    position: fixed;
    top: 0;
    width: 100%;
    background-color: rgba(10, 10, 10, 0.95); /* dark bg with opacity */
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(55, 65, 81, 0.3); /* border-gray-700 */
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 50;
  }

  .navbar.scrolled {
    background-color: rgba(17, 24, 39, 0.98); /* bg-gray-900 with opacity */
    border-bottom-color: rgba(75, 85, 99, 0.5); /* border-gray-600 */
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.7);
  }

  .navbar ul {
    list-style: none;
    padding: 0 2rem;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    gap: 3rem;
    max-width: 100%;
  }

  .navbar li {
    padding: 1rem 1.5rem;
  }

  .navbar a {
    color: #9ca3af; /* text-gray-400 */
    font-family: 'Fira Code', 'Monaco', monospace;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid transparent;
    padding: 0.5rem 1.2rem;
    border-radius: 8px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    font-size: 0.9rem;
  }

  .navbar a:hover {
    color: #60a5fa; /* text-blue-400 */
    border-color: rgba(96, 165, 250, 0.3); /* border-blue-400 */
    background-color: rgba(96, 165, 250, 0.1); /* bg-blue-400/10 */
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(96, 165, 250, 0.2);
  }

  .navbar a:active {
    transform: translateY(0);
    box-shadow: 0 2px 10px rgba(96, 165, 250, 0.1);
  }

  @media (max-width: 768px) {
    .navbar ul {
      gap: 1rem;
    }
    
    .navbar li {
      padding: 0.75rem 0.5rem;
    }
    
    .navbar a {
      padding: 0.4rem 0.8rem;
      font-size: 0.9rem;
    }
  }
</style>

<nav class='navbar font-semibold' id='navbar'>
  <ul>
    <li><a href='#home'>Home</a></li>
    <li><a href='#about'>About Me</a></li>
    <li><a href='#habilidades'>Skills</a></li>
    <li><a href='#projects'>Projects</a></li>
    <li><a href='#contact'>Contact</a></li>
  </ul>
</nav>

<script>
  // Add scroll effect to navbar
  window.addEventListener('scroll', () => {
    const navbar = document.getElementById('navbar');
    if (window.scrollY > 50) {
      navbar?.classList.add('scrolled');
    } else {
      navbar?.classList.remove('scrolled');
    }
  });
</script>
