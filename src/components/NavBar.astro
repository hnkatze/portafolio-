<style>
  .navbar {
    position: fixed;
    top: 0;
    width: 100%;
    background-color: rgba(229, 231, 235, 0.95); /* bg-gray-200 with opacity */
    backdrop-filter: blur(8px);
    border-bottom: 2px solid #9ca3af; /* border-gray-400 */
    box-shadow: 4px 4px 0px rgba(0, 0, 0, 0.1);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 50;
  }

  .navbar.scrolled {
    background-color: rgba(209, 213, 219, 0.98); /* bg-gray-300 with opacity */
    border-bottom-color: #6b7280; /* border-gray-500 */
    box-shadow: 6px 6px 0px rgba(0, 0, 0, 0.15);
  }

  .navbar ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    justify-content: center;
    gap: 2rem;
  }

  .navbar li {
    padding: 1rem 1.5rem;
  }

  .navbar a {
    color: #374151; /* text-gray-700 */
    font-family: 'Courier New', monospace;
    font-weight: 600;
    text-decoration: none;
    border: 2px solid transparent;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
  }

  .navbar a:hover {
    color: #111827; /* text-gray-900 */
    border-color: #6b7280; /* border-gray-500 */
    background-color: rgba(243, 244, 246, 0.8); /* bg-gray-100 */
    transform: translateY(-2px);
    box-shadow: 2px 2px 0px rgba(0, 0, 0, 0.1);
  }

  .navbar a:active {
    transform: translateY(0);
    box-shadow: 1px 1px 0px rgba(0, 0, 0, 0.1);
  }

  @media (max-width: 768px) {
    .navbar ul {
      gap: 1rem;
    }
    
    .navbar li {
      padding: 0.75rem 0.5rem;
    }
    
    .navbar a {
      padding: 0.4rem 0.8rem;
      font-size: 0.9rem;
    }
  }
</style>

<nav class='navbar font-semibold' id='navbar'>
  <ul>
    <li><a href='#home'>Home</a></li>
    <li><a href='#habilidades'>Skills</a></li>
    <li><a href='#projects'>Projects</a></li>
    <li><a href='#contact'>Contact</a></li>
  </ul>
</nav>

<script>
  // Add scroll effect to navbar
  window.addEventListener('scroll', () => {
    const navbar = document.getElementById('navbar');
    if (window.scrollY > 50) {
      navbar?.classList.add('scrolled');
    } else {
      navbar?.classList.remove('scrolled');
    }
  });
</script>
