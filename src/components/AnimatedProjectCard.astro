---
import { Image } from "astro:assets";
---

<div 
  class="animated-project-card w-full max-w-[350px] min-h-[480px] flex flex-col border-2 border-gray-400 rounded-lg shadow-xl bg-gradient-to-br from-gray-200 via-gray-100 to-gray-50 overflow-hidden group hover:border-gray-600 transition-all duration-300"
>
  <div class="relative overflow-hidden bg-gray-300 h-44">
    <Image
      src={Astro.props.images}
      alt={Astro.props.title}
      width={350}
      height={200}
      class="w-full h-full object-cover transition-all duration-500 group-hover:scale-105 grayscale hover:grayscale-0"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-gray-900/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
    <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-x-4 group-hover:translate-x-0">
      <div class="w-3 h-3 bg-gray-800 rounded-full border-2 border-gray-200 shadow-lg"></div>
    </div>
  </div>

  <div class="p-6 flex flex-col justify-between text-gray-800 h-full bg-gray-50">
    <div>
      <h2 class="font-bold text-2xl mb-3 text-gray-900 transform transition-transform duration-300 group-hover:scale-105 font-mono">
        {Astro.props.title}
      </h2>
      <p class="text-sm text-gray-600 mb-4 leading-relaxed group-hover:text-gray-800 transition-colors duration-300">
        {Astro.props.description}
      </p>
    </div>

    <div class="flex flex-wrap gap-2 mb-6">
      {Astro.props.technologies.map((tech: string, index: number) => (
        <span 
          class="tech-badge bg-gray-300 text-gray-800 text-xs font-semibold px-3 py-1.5 rounded border border-gray-400 transition-all duration-300 hover:bg-gray-800 hover:text-gray-100 hover:scale-105 hover:shadow-md font-mono"
          style={`animation-delay: ${index * 100}ms`}
        >
          {tech}
        </span>
      ))}
    </div>

    <div class="w-full flex justify-between items-center mt-auto pt-4 border-t border-gray-300">
      <a
        href={Astro.props.repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group/link flex items-center text-gray-600 hover:text-gray-900 transition-all duration-300 hover:scale-105 font-mono text-sm"
      >
        <svg class="h-4 w-4 mr-2 transition-transform duration-300 group-hover/link:rotate-12" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        <span class="font-medium">Code</span>
      </a>
      
      {Astro.props.projectUrl && (
        <a
          href={Astro.props.projectUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group/link flex items-center text-gray-600 hover:text-gray-900 transition-all duration-300 hover:scale-105 font-mono text-sm"
        >
          <svg class="h-4 w-4 mr-2 transition-transform duration-300 group-hover/link:-rotate-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
          <span class="font-medium">Demo</span>
        </a>
      )}
    </div>
  </div>
</div>

<style>
  .animated-project-card {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 4px 4px 0px rgba(0, 0, 0, 0.1);
    opacity: 1;
    transform: translateY(0);
  }
  
  .animated-project-card:hover {
    transform: translateY(-4px) translateX(-2px);
    box-shadow: 8px 8px 0px rgba(0, 0, 0, 0.15);
  }
  
  .tech-badge {
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
    transform: translateY(10px);
    box-shadow: 2px 2px 0px rgba(0, 0, 0, 0.1);
  }
  
  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* Ensure cards are visible and properly sized */
  .animated-project-card {
    display: flex !important;
    visibility: visible !important;
    min-height: 480px;
    max-height: none;
  }
  
  .animated-project-card:hover .tech-badge {
    animation: none;
    box-shadow: 3px 3px 0px rgba(0, 0, 0, 0.2);
  }
</style>
