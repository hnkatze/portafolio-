---
import { Image } from "astro:assets";
---

<div 
  class="animated-project-card w-full min-h-[480px] flex flex-col rounded-xl overflow-hidden group bg-gray-900/50 backdrop-blur-lg border border-gray-800 hover:border-gray-700 transition-all duration-300"
>
  <!-- Code-style header -->
  <div class="px-4 py-2 bg-gray-900/80 border-b border-gray-800 font-mono text-xs">
    <span class="text-gray-500">// Project:</span> <span class="text-blue-400">{Astro.props.title.replace(/\s+/g, '_')}</span>
  </div>

  <div class="relative overflow-hidden h-48">
    <Image
      src={Astro.props.images}
      alt={Astro.props.title}
      width={400}
      height={200}
      class="w-full h-full object-cover transition-all duration-500 group-hover:scale-110 opacity-80 group-hover:opacity-100"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/50 to-transparent"></div>
    <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-x-4 group-hover:translate-x-0">
      <div class="w-10 h-10 bg-blue-500/20 backdrop-blur-lg rounded-lg flex items-center justify-center border border-blue-500/30">
        <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
      </div>
    </div>
  </div>

  <div class="p-6 flex flex-col justify-between h-full">
    <div>
      <h2 class="font-bold text-xl mb-3 text-gray-100 font-mono">
        <span class="text-purple-400">class</span> {Astro.props.title.replace(/\s+/g, '')} <span class="text-gray-500">{`{`}</span>
      </h2>
      <p class="text-sm text-gray-400 mb-4 leading-relaxed pl-4 font-mono">
        <span class="text-gray-600">// </span>{Astro.props.description}
      </p>
    </div>

    <div class="mb-6">
      <div class="font-mono text-xs text-gray-500 mb-2 pl-4">technologies: [</div>
      <div class="flex flex-wrap gap-2 pl-8">
        {Astro.props.technologies.map((tech: string, index: number) => (
          <span 
            class="tech-badge bg-gray-800/50 text-blue-400 text-xs font-mono px-3 py-1.5 rounded border border-gray-700 transition-all duration-300 hover:bg-gray-800 hover:border-blue-500/30"
            style={`animation-delay: ${index * 50}ms`}
          >
            "{tech}"
          </span>
        ))}
      </div>
      <div class="font-mono text-xs text-gray-500 mt-2 pl-4">]</div>
    </div>

    <div class="w-full flex justify-between items-center mt-auto pt-4 border-t border-gray-800">
      <a
        href={Astro.props.repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group/link flex items-center text-gray-400 hover:text-blue-400 transition-all duration-300 text-sm font-mono"
      >
        <svg class="h-4 w-4 mr-2 transition-transform duration-300 group-hover/link:rotate-12" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        <span>.getCode()</span>
      </a>
      
      {Astro.props.projectUrl && (
        <a
          href={Astro.props.projectUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group/link flex items-center text-gray-400 hover:text-purple-400 transition-all duration-300 text-sm font-mono"
        >
          <svg class="h-4 w-4 mr-2 transition-transform duration-300 group-hover/link:-rotate-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
          <span>.view()</span>
        </a>
      )}
    </div>
    
    <!-- Closing bracket -->
    <div class="font-mono text-xs text-gray-500 mt-2"><span class="text-gray-500">{`}`}</span></div>
  </div>
</div>

<style>
  .animated-project-card {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 1;
    transform: translateY(0);
  }
  
  .tech-badge {
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
    transform: translateY(10px);
  }
  
  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* Ensure cards are visible and properly sized */
  .animated-project-card {
    display: flex !important;
    visibility: visible !important;
    min-height: 480px;
    max-height: none;
  }
  
  .animated-project-card:hover .tech-badge {
    animation: none;
  }
</style>
