---
import CVLayout from "../layouts/CVLayout.astro";
import { Image } from "astro:assets";
import meb from "../../public/tshirtw.png";
import "../styles/cv-layout.css";

// Contact info
const contact = {
  email: "contact@camilohenriquez.com",
  phone: "+1 (555) 123-4567",
  location: "Remote / Worldwide",
  linkedin: "linkedin.com/in/camilohenriquez",
  github: "github.com/camilohenriquez",
  website: "templates.camilohenriquez.com"
};

// Experience data
const experience = [
  {
    title: "Associate Developer",
    company: "Tech Company",
    date: "July 2024 - Present",
    description: "Developing scalable web applications using modern JavaScript frameworks. Collaborating with cross-functional teams to deliver high-quality software solutions.",
    achievements: [
      "Improved application performance by 40%",
      "Implemented CI/CD pipelines",
      "Led frontend architecture decisions"
    ]
  },
  {
    title: "Freelance Full Stack Developer",
    company: "Self-Employed",
    date: "2021 - 2024",
    description: "Delivered custom web solutions for diverse clients. Specialized in React, Next.js, and Node.js applications.",
    achievements: [
      "Completed 25+ projects",
      "Maintained 100% client satisfaction",
      "Built reusable component libraries"
    ]
  }
];

// Education
const education = [
  {
    degree: "Bachelor of Computer Science",
    school: "University Name",
    date: "2018 - 2022",
    description: "Focus on Software Engineering and Web Technologies"
  }
];

// Languages
const languages = [
  { name: "Spanish", level: "Native" },
  { name: "English", level: "Professional" },
];

// Core skills for sidebar
const coreSkills = [
  "React", "Next.js", "TypeScript", "Node.js", 
  "Astro", "Tailwind CSS", "PostgreSQL", "MongoDB",
  "Git", "Docker", "AWS", "Agile"
];
---

<CVLayout title="Camilo Henriquez - Full Stack Developer CV">
  <div class="cv-container">
    <div class="cv-layout">
      <!-- Sidebar -->
      <aside class="cv-sidebar">
        <!-- Profile Section -->
        <div class="cv-header">
          <div class="mb-6 flex justify-center">
            <Image
              src={meb}
              alt="Camilo Henriquez"
              class="w-32 h-32 rounded-full object-cover border-4 border-white shadow-lg"
            />
          </div>
          <h1 class="cv-name">Camilo Henriquez</h1>
          <p class="cv-title">Full Stack Developer</p>
          <p class="cv-summary">
            Passionate developer with 3+ years of experience building scalable web applications. 
            Focused on clean code, best practices, and delivering exceptional user experiences.
          </p>
        </div>

        <!-- Contact Section -->
        <div class="cv-section">
          <h2 class="cv-section-title">
            <svg class="cv-contact-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Contact
          </h2>
          <div class="cv-contact">
            <a href={`mailto:${contact.email}`} class="cv-contact-item">
              <svg class="cv-contact-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              {contact.email}
            </a>
            <div class="cv-contact-item">
              <svg class="cv-contact-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              {contact.location}
            </div>
            <a href={`https://${contact.linkedin}`} target="_blank" class="cv-contact-item">
              <svg class="cv-contact-icon" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
              LinkedIn
            </a>
            <a href={`https://${contact.github}`} target="_blank" class="cv-contact-item">
              <svg class="cv-contact-icon" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              GitHub
            </a>
            <a href={`https://${contact.website}`} target="_blank" class="cv-contact-item">
              <svg class="cv-contact-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
              Templates Portfolio
            </a>
          </div>
        </div>

        <!-- Skills Section -->
        <div class="cv-section">
          <h2 class="cv-section-title">
            <svg class="cv-contact-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
            Technical Skills
          </h2>
          <div class="cv-skills">
            {coreSkills.map(skill => (
              <span class="cv-skill-tag">{skill}</span>
            ))}
          </div>
        </div>

        <!-- Languages Section -->
        <div class="cv-section">
          <h2 class="cv-section-title">
            <svg class="cv-contact-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
            </svg>
            Languages
          </h2>
          <div class="cv-languages">
            {languages.map(lang => (
              <div class="cv-language-item">
                <span class="cv-language-name">{lang.name}</span>
                <span class="cv-language-level">{lang.level}</span>
              </div>
            ))}
          </div>
        </div>


      </aside>

      <!-- Main Content -->
      <main class="cv-main">
        <!-- Experience Section -->
        <section class="cv-section">
          <h2 class="cv-section-title">
            <svg class="cv-contact-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Professional Experience
          </h2>
          <div class="cv-timeline">
            {experience.map(job => (
              <div class="cv-timeline-item fade-in">
                <div class="cv-timeline-date">{job.date}</div>
                <h3 class="cv-timeline-title">{job.title}</h3>
                <div class="cv-timeline-company">{job.company}</div>
                <p class="cv-timeline-description">{job.description}</p>
                {job.achievements && (
                  <ul class="mt-2 space-y-1">
                    {job.achievements.map(achievement => (
                      <li class="text-sm text-gray-600 dark:text-gray-400 flex items-start">
                        <span class="text-blue-500 mr-2">•</span>
                        {achievement}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </section>

        <!-- Education Section -->
        <section class="cv-section">
          <h2 class="cv-section-title">
            <svg class="cv-contact-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
            </svg>
            Education
          </h2>
          <div class="space-y-4">
            {education.map(edu => (
              <div class="cv-education-item fade-in">
                <h3 class="cv-education-degree">{edu.degree}</h3>
                <div class="cv-education-school">{edu.school}</div>
                <div class="cv-education-date">{edu.date}</div>
                {edu.description && (
                  <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">{edu.description}</p>
                )}
              </div>
            ))}
          </div>
        </section>

        <!-- Featured Work Section -->
        <section class="cv-section">
          <h2 class="cv-section-title">
            <svg class="cv-contact-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            Featured Work
          </h2>
          
          <!-- Simple project showcase -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            <div class="cv-project-card">
              <h3 class="cv-project-title">E-Commerce Platform</h3>
              <p class="cv-project-description">Full-stack application with React and Node.js</p>
              <div class="cv-project-tech">
                <span class="cv-project-tech-tag">React</span>
                <span class="cv-project-tech-tag">Node.js</span>
                <span class="cv-project-tech-tag">MongoDB</span>
              </div>
            </div>
            
            <div class="cv-project-card">
              <h3 class="cv-project-title">SaaS Dashboard</h3>
              <p class="cv-project-description">Analytics dashboard with real-time data</p>
              <div class="cv-project-tech">
                <span class="cv-project-tech-tag">Next.js</span>
                <span class="cv-project-tech-tag">TypeScript</span>
                <span class="cv-project-tech-tag">PostgreSQL</span>
              </div>
            </div>
          </div>

          <!-- Link to templates -->
          <div class="text-center p-6 bg-gradient-to-r from-blue-50 to-purple-50 dark:from-blue-900/20 dark:to-purple-900/20 rounded-lg border border-blue-200 dark:border-blue-800">
            <p class="text-lg font-semibold text-gray-800 dark:text-gray-200 mb-2">
              View My Complete Template Collection
            </p>
            <a 
              href={`https://${contact.website}`} 
              target="_blank"
              class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              templates.camilohenriquez.com
            </a>
            <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">
              25+ Professional Templates & Projects
            </p>
          </div>
        </section>

        <!-- Certifications/Achievements (Optional) -->
        <section class="cv-section">
          <h2 class="cv-section-title">
            <svg class="cv-contact-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
            Key Achievements
          </h2>
          <ul class="space-y-2">
            <li class="flex items-start">
              <span class="text-blue-500 mr-2 mt-1">✓</span>
              <span class="text-gray-700 dark:text-gray-300">Successfully delivered 25+ projects with 100% client satisfaction</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-500 mr-2 mt-1">✓</span>
              <span class="text-gray-700 dark:text-gray-300">Improved application performance by 40% through optimization</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-500 mr-2 mt-1">✓</span>
              <span class="text-gray-700 dark:text-gray-300">Implemented modern CI/CD pipelines and development workflows</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-500 mr-2 mt-1">✓</span>
              <span class="text-gray-700 dark:text-gray-300">Built and maintained reusable component libraries</span>
            </li>
          </ul>
        </section>
      </main>
    </div>
  </div>
</CVLayout>

<style>
  /* Additional custom styles */
  @media print {
    body {
      font-size: 11pt;
    }
    
    .cv-container {
      max-width: 100%;
    }
  }
</style>