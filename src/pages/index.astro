---
import Layout from "@/layouts/Layout.astro";
import "@/styles/journey.css";

// Data imports
import {
  personalInfo,
  skills,
  projects,
  experience,
  education,
  certifications,
  languages,
  integrationConfig,
} from "@/libs/utils";

// Journey components (Astro)
import JourneyNav from "@/components/journey/JourneyNav.astro";
import HeroIsland from "@/components/journey/HeroIsland.astro";
import SkillsIsland from "@/components/journey/SkillsIsland.astro";
import ExperienceIsland from "@/components/journey/ExperienceIsland.astro";
import ProjectsIsland from "@/components/journey/ProjectsIsland.astro";
import IntegrationsIsland from "@/components/journey/IntegrationsIsland.astro";
import ContactIsland from "@/components/journey/ContactIsland.astro";
import CVTemplate from "@/components/cv/CVTemplate.astro";

// Integration components (Astro - static/build-time)
import GitHubStats from "@/components/integrations/GitHubStats.astro";
import GitHubContributions from "@/components/integrations/GitHubContributions.astro";
import GitHubRepos from "@/components/integrations/GitHubRepos.astro";

const lang = "en" as const;
---

<Layout title="Camilo Henriquez — Frontend Developer">
  <JourneyNav />

  <HeroIsland data={personalInfo} lang={lang} />

  <SkillsIsland skills={skills} />

  <ExperienceIsland experience={experience} lang={lang} />

  <ProjectsIsland projects={projects} lang={lang} />

  <IntegrationsIsland config={integrationConfig}>
    <GitHubStats username={integrationConfig.github.username} theme={integrationConfig.github.statsTheme} />
    <GitHubContributions username={integrationConfig.github.username} />
    <GitHubRepos username={integrationConfig.github.username} />
  </IntegrationsIsland>

  <ContactIsland data={personalInfo} />

  <CVTemplate
    personalInfo={personalInfo}
    skills={skills}
    experience={experience}
    education={education}
    certifications={certifications}
    languages={languages}
    initialLang={lang}
  />
</Layout>
