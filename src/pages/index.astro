---
import CVLayout from "../layouts/CVLayout.astro";
import { Image } from "astro:assets";
import meb from "../../public/tshirtw.png";
import "../styles/minimal-cv.css";

// Personal Information
const personal = {
  name: "Camilo Henriquez",
  title: "Full Stack Developer",
  summary: "Passionate developer with 3+ years of experience building scalable web applications. Specialized in React, Next.js, and modern JavaScript frameworks. Focused on clean code, best practices, and delivering exceptional user experiences.",
  email: "contact@camilohenriquez.com",
  phone: "+1 (555) 123-4567",
  location: "Remote / Worldwide",
  linkedin: "linkedin.com/in/camilohenriquez",
  github: "github.com/camilohenriquez",
  portfolio: "templates.camilohenriquez.com"
};

// Experience
const experience = [
  {
    title: "Associate Developer",
    company: "Creative Information Technologies",
    date: "July 2024 - Present",
    description: "Developing scalable web applications using modern JavaScript frameworks. Collaborating with cross-functional teams to deliver high-quality software solutions.",
    achievements: [
      "Improved application performance by 40%",
      "Implemented CI/CD pipelines reducing deployment time by 60%",
      "Led frontend architecture decisions for 3 major projects"
    ]
  },
  {
    title: "Full Stack Developer",
    company: "Freelance",
    date: "2021 - Present",
    description: "Delivered custom web solutions for diverse clients across various industries. Specialized in React, Next.js, and Node.js applications.",
    achievements: [
      "Successfully completed 25+ projects",
      "Maintained 100% client satisfaction rate",
      "Built reusable component libraries saving 30% development time"
    ]
  }
];

// Education
const education = [
  {
    degree: "Ingeniería en Informática",
    school: "CEUTEC",
    date: "En curso",
    highlights: ["Software Engineering", "Web Technologies", "Data Structures"]
  },
  {
    degree: "Técnico Universitario Bilingüe en Call Center",
    school: "CEUTEC",
    date: "Completado",
    highlights: ["Customer Service", "English Proficiency", "Communication Skills"]
  }
];

// Skills
const skills = {
  frontend: ["React", "Next.js", "TypeScript", "Astro", "Tailwind CSS", "HTML/CSS", "Angular", "Lit"],
  backend: ["Node.js", "Express", "PostgreSQL", "MongoDB", "REST APIs", "GraphQL", "NestJS"],
  tools: ["Git", "Docker", "AWS", "CI/CD", "Firebase", "Jest", "Webpack"]
};

// Languages
const languages = [
  { name: "Spanish", level: "Native" },
  { name: "English", level: "Professional" }
];

// Featured Projects (minimal)
const projects = [
  {
    name: "E-Commerce Platform",
    description: "Full-stack application with real-time inventory",
    tech: ["React", "Node.js", "MongoDB"]
  },
  {
    name: "SaaS Dashboard",
    description: "Analytics platform with data visualization",
    tech: ["Next.js", "TypeScript", "PostgreSQL"]
  }
];
---

<CVLayout title={`${personal.name} - ${personal.title}`}>
  <div class="cv-page">
    <!-- Header Section -->
    <header class="cv-header">
      <!-- Profile Photo -->
      <div style="margin-bottom: 24px;">
        <Image
          src={meb}
          alt={personal.name}
          width={120}
          height={120}
          style="border-radius: 50%; border: 3px solid var(--accent); margin: 0 auto;"
        />
      </div>
      <h1>{personal.name}</h1>
      <div class="title">{personal.title}</div>
      <p class="summary">{personal.summary}</p>
      
      <!-- Contact Information -->
      <div class="contact-bar">
        <a href={`mailto:${personal.email}`} class="contact-item">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          {personal.email}
        </a>
        
        <div class="contact-item">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          {personal.location}
        </div>
        
        <a href={`https://${personal.linkedin}`} target="_blank" class="contact-item">
          <svg fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
          LinkedIn
        </a>
        
        <a href={`https://${personal.github}`} target="_blank" class="contact-item">
          <svg fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          GitHub
        </a>
      </div>
    </header>

    <!-- Body Content -->
    <div class="cv-body">
      <!-- Main Content -->
      <main class="cv-main">
        <!-- Experience Section -->
        <section class="cv-section">
          <h2>Professional Experience</h2>
          <div class="experience-timeline">
            {experience.map(job => (
              <div class="experience-item fade-in">
                <div class="experience-date">{job.date}</div>
                <h3 class="experience-title">{job.title}</h3>
                <div class="experience-company">{job.company}</div>
                <p class="experience-description">{job.description}</p>
                {job.achievements && (
                  <ul style="margin-top: 12px; padding-left: 20px;">
                    {job.achievements.map(achievement => (
                      <li style="color: var(--text-secondary); font-size: 0.875rem; margin-bottom: 4px;">
                        {achievement}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </section>

        <!-- Education Section -->
        <section class="cv-section">
          <h2>Education</h2>
          {education.map(edu => (
            <div class="education-item" style="margin-bottom: 24px;">
              <div class="experience-date">{edu.date}</div>
              <h3 class="experience-title">{edu.degree}</h3>
              <div class="experience-company">{edu.school}</div>
              <div style="margin-top: 8px;">
                {edu.highlights.map((item, index) => (
                  <span style="color: var(--text-secondary); font-size: 0.875rem;">
                    {item}{index < edu.highlights.length - 1 ? " • " : ""}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </section>

        <!-- Projects Section -->
        <section class="cv-section">
          <h2>Featured Projects</h2>
          <div class="projects-grid">
            {projects.map(project => (
              <div class="project-card">
                <h3 class="project-title">{project.name}</h3>
                <p class="project-description">{project.description}</p>
                <div class="project-tech">
                  {project.tech.map(tech => (
                    <span class="tech-tag">{tech}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
          
          <!-- Portfolio Link -->
          <div style="margin-top: 32px; padding: 24px; background: var(--bg-secondary); border-radius: 8px; text-align: center;">
            <p style="margin-bottom: 16px; color: var(--text-primary); font-weight: 500;">
              View My Complete Portfolio
            </p>
            <a 
              href={`https://${personal.portfolio}`}
              target="_blank"
              style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; background: var(--accent); color: white; border-radius: 6px; font-weight: 500; text-decoration: none; transition: all 0.2s;"
              onmouseover="this.style.background='var(--accent-hover)'; this.style.transform='translateY(-2px)'"
              onmouseout="this.style.background='var(--accent)'; this.style.transform='translateY(0)'"
            >
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              templates.camilohenriquez.com
            </a>
          </div>
        </section>
      </main>

      <!-- Sidebar -->
      <aside class="cv-sidebar">
        <!-- Skills Section -->
        <section class="cv-section">
          <h2>Technical Skills</h2>
          
          <div style="margin-bottom: 20px;">
            <h3 style="font-size: 0.875rem; color: var(--text-secondary); margin-bottom: 8px; font-weight: 500;">Frontend</h3>
            <div class="skills-grid">
              {skills.frontend.map(skill => (
                <span class="skill-tag">{skill}</span>
              ))}
            </div>
          </div>
          
          <div style="margin-bottom: 20px;">
            <h3 style="font-size: 0.875rem; color: var(--text-secondary); margin-bottom: 8px; font-weight: 500;">Backend</h3>
            <div class="skills-grid">
              {skills.backend.map(skill => (
                <span class="skill-tag">{skill}</span>
              ))}
            </div>
          </div>
          
          <div>
            <h3 style="font-size: 0.875rem; color: var(--text-secondary); margin-bottom: 8px; font-weight: 500;">Tools & DevOps</h3>
            <div class="skills-grid">
              {skills.tools.map(skill => (
                <span class="skill-tag">{skill}</span>
              ))}
            </div>
          </div>
        </section>

        <!-- Languages Section -->
        <section class="cv-section">
          <h2>Languages</h2>
          <div style="display: flex; flex-direction: column; gap: 8px;">
            {languages.map(lang => (
              <div class="language-item">
                <span class="language-name">{lang.name}</span>
                <span class="language-level">{lang.level}</span>
              </div>
            ))}
          </div>
        </section>


      </aside>
    </div>
  </div>
</CVLayout>