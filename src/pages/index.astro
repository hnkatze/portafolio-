---
import Layout from "@/layouts/Layout.astro";
import "@/styles/journey.css";

// Data imports
import {
  personalInfo,
  skills,
  projects,
  experience,
  education,
  certifications,
  languages,
  integrationConfig,
} from "@/libs/utils";

// Journey components
import JourneyNav from "@/components/journey/JourneyNav";
import HeroIsland from "@/components/journey/HeroIsland";
import SkillsIsland from "@/components/journey/SkillsIsland";
import ExperienceIsland from "@/components/journey/ExperienceIsland";
import ProjectsIsland from "@/components/journey/ProjectsIsland";
import IntegrationsIsland from "@/components/journey/IntegrationsIsland";
import ContactIsland from "@/components/journey/ContactIsland";
import CVTemplate from "@/components/cv/CVTemplate";

// Integration components (Astro - static/build-time)
import GitHubStats from "@/components/integrations/GitHubStats.astro";
import GitHubContributions from "@/components/integrations/GitHubContributions.astro";
import GitHubRepos from "@/components/integrations/GitHubRepos.astro";

const lang = "en" as const;
---

<Layout title="Camilo Henriquez — Frontend Developer">
  <JourneyNav client:load />

  <HeroIsland data={personalInfo} lang={lang} client:load />

  <SkillsIsland skills={skills} client:visible />

  <ExperienceIsland experience={experience} lang={lang} client:visible />

  <ProjectsIsland projects={projects} lang={lang} client:visible />

  <IntegrationsIsland config={integrationConfig} client:visible>
    <GitHubStats username={integrationConfig.github.username} theme={integrationConfig.github.statsTheme} />
    <GitHubContributions username={integrationConfig.github.username} />
    <GitHubRepos username={integrationConfig.github.username} />
  </IntegrationsIsland>

  <ContactIsland data={personalInfo} client:visible />

  <CVTemplate
    personalInfo={personalInfo}
    skills={skills}
    experience={experience}
    education={education}
    certifications={certifications}
    languages={languages}
    initialLang={lang}
    client:load
  />
</Layout>
