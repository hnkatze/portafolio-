            "@type": "Language",
            "name": "English",
            "alternateName": "en"
          }
        ]
      }
    </script>
    
    <!-- BreadcrumbList Schema -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://camilohenriquez.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "CV",
            "item": "https://camilohenriquez.com/cv"
          }
        ]
      }
    </script>
    
    <!-- WebSite Schema -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Camilo Henriquez Portfolio",
        "url": "https://camilohenriquez.com",
        "description": "Frontend-Focused Developer Portfolio - React, Next.js, Angular, TypeScript Expert",
