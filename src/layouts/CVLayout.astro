---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Camilo Henriquez — Frontend-Focused Developer. View my professional CV and portfolio.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Camilo Henriquez" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://camilohenriquez.com/cv" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://camilohenriquez.com/cv" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Schema.org -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Camilo Henriquez",
        "url": "https://camilohenriquez.com",
        "image": "https://camilohenriquez.com/tshirtw.png",
        "sameAs": [
          "https://linkedin.com/in/camilohenriquez",
          "https://github.com/hnkatze"
        ],
        "jobTitle": "Frontend-Focused Developer",
        "worksFor": {
          "@type": "Organization",
          "name": "Creative Information Technologies"
        },
        "alumniOf": {
          "@type": "CollegeOrUniversity",
          "name": "CEUTEC"
        },
        "email": "contact@camilohenriquez.com",
        "knowsLanguage": ["Spanish", "English"]
      }
    </script>

    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: "Inter", system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  @media print {
    body {
      font-size: 11pt;
      line-height: 1.4;
    }

    .print\:hidden {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
