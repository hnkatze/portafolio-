        "sameAs": [
          "https://linkedin.com/in/camilohenriquez",
          "https://github.com/camilohenriquez",
          "https://templates.camilohenriquez.com"
        ],
        "jobTitle": "Frontend-Focused Developer",
        "worksFor": {
          "@type": "Organization",
          "name": "Creative Information Technologies",
          "url": "https://creativeit.com"
        },
        "knowsAbout": ["React", "Next.js", "TypeScript", "Node.js", "JavaScript", "Astro", "Angular", "TailwindCSS", "PostgreSQL", "MongoDB", "Express.js", "NestJS", "GraphQL", "REST API", "Git", "Docker", "AWS", "Firebase", "Jest", "Webpack", "HTML5", "CSS3", "Sass", "Redux", "React Hooks", "Responsive Design", "SEO", "Web Performance", "Agile", "Scrum"],
        "hasOccupation": {
          "@type": "Occupation",
          "name": "Frontend-Focused Developer",
          "occupationalCategory": "15-1252.00",
          "occupationLocation": {
            "@type": "City",
            "name": "Remote"
          },
          "estimatedSalary": {
